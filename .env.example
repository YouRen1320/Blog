# Local database and API. Copy this file to .env and replace secret values.
NODE_ENV=development
POSTGRES_USER=blog
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=blog
POSTGRES_PORT=5432
DATABASE_URL=postgresql://blog:replace-with-a-local-password@localhost:5432/blog?schema=public
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRES_IN=7d
AI_SERVICE_BASE_URL=http://127.0.0.1:8001

# One-time administrator bootstrap. Remove ADMIN_PASSWORD after creation.
ADMIN_EMAIL=owner@example.com
ADMIN_USERNAME=owner
ADMIN_PASSWORD=replace-with-at-least-12-characters

# Local/CI demo seed and browser-test identity; never use in production.
E2E_ADMIN_EMAIL=e2e-admin@example.test
E2E_ADMIN_USERNAME=e2e-admin
E2E_ADMIN_PASSWORD=e2e-admin-password

# AI service defaults to deterministic local responses.
USE_MOCK_LLM=true
XIAOMI_MIMO_API_KEY=
