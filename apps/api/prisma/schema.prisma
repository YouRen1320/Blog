// Blog 数据模型 —— V1 第一版
// 参考 README §681-753

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// 区分文章是手动创建还是 AI 生成
enum ArticleSource {
  MANUAL
  AI
}

enum CommentStatus {
  PENDING    // 默认,待审核
  APPROVED   // 通过,在 web 端可见
  REJECTED   // 拒绝,不显示;留底以便分析垃圾来源
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  email        String    @unique
  passwordHash String
  role         UserRole  @default(USER)
  articles     Article[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model Article {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  summary     String?
  content     String
  cover       String?
  status      ArticleStatus @default(DRAFT)
  source      ArticleSource @default(MANUAL)
  authorId    String
  categoryId  String?
  publishedAt DateTime?
  // 512 维向量(BGE-small-zh-v1.5 输出)。Prisma 不原生支持 vector,
  // 用 Unsupported 占位,业务层走 raw SQL 写入(`embedding = $1::vector(512)`)
  embedding   Unsupported("vector(512)")?
  author      User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags        ArticleTag[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  comments    Comment[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("articles")
}

// 匿名评论:游客填昵称 + 邮箱(邮箱不公开),正文 1-1000 字。
// 默认 PENDING,管理员后台审核后改 APPROVED 才在 web 显示。
// parentId 预留嵌套(暂不开启),onDelete: Cascade 让删评论自动删回复。
// ipAddress 用于反垃圾分析,不公开;邮箱同理。
model Comment {
  id          String        @id @default(cuid())
  articleId   String
  parentId    String?
  authorName  String
  authorEmail String
  content     String
  status      CommentStatus @default(PENDING)
  ipAddress   String?
  article     Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  parent      Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]     @relation("CommentReplies")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([articleId, status, createdAt])
  @@index([status])
  @@map("comments")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  articles    Article[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  slug      String       @unique
  articles  ArticleTag[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("tags")
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@map("article_tags")
}

// 全局站点配置。永远只有一行(id="singleton"),
// title / tagline / icp 影响 web 端展示;其他字段是 admin UI 占位,
// 后续若接入运行时配置(AI model 切换、JWT 过期等)直接读这张表。
model SiteSetting {
  id           String   @id @default("singleton")
  title        String   @default("YouRen")
  tagline      String   @default("An element-soul who writes.")
  icp          String   @default("")
  aiModel      String   @default("mimo-v2.5-pro")
  aiThreshold  Int      @default(85)
  aiStreaming  Boolean  @default(true)
  aiRagRelated Boolean  @default(true)
  jwtHours     Int      @default(24)
  requireMfa   Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  @@map("site_settings")
}
